        "states": {
          "h-a": "verifying",
          "h-b": "aborting",
          "h-c": "aborted"
        }
      }
    },
    {
      "action": "expectSummary",
      "expect": {
        "verifying": 1,
        "aborting": 1,
        "aborted": 1
      }
    }
