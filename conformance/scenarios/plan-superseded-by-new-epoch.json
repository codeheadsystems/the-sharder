{
  "scenario": "plan-superseded-by-new-epoch",
  "level": "migration",
  "description": "A third epoch arrives while three handoffs are in flight.  A comparable epoch marks the plan rebase pending and aborts nothing; an incomparable one supersedes it, pre-cutover handoffs abort, and the handoff past cutover runs on.",
  "requirements": [
    "MOVE-091",
    "MOVE-092",
    "MOVE-093",
    "MOVE-101",
    "MOVE-481",
    "TOPO-111",
    "TOPO-131",
    "TOPO-231"
  ],
  "deterministic": true,
  "setup": {},
  "steps": [
    {
      "action": "handoffStep",
      "handoff": "h-a",
      "trigger": "admittedByRatePolicy",
      "at": 1000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-a",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-a",
      "trigger": "prepareSuccess",
      "at": 1100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-a",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-a",
      "trigger": "noBulkRemaining",
      "at": 1200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-a",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-a",
      "trigger": "residueAtOrBelowThreshold",
      "at": 1300,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-a",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-a",
      "trigger": "cutoverCommitted",
      "at": 1400,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-a",
          "fromState": "cutover",
          "toState": "verifying"
        },
        "state": "verifying"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-b",
      "trigger": "admittedByRatePolicy",
      "at": 1000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-b",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-b",
      "trigger": "prepareSuccess",
      "at": 1100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-b",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "snapshotInstalled",
      "topologyId": "migration",
      "epoch": 4,
      "at": 50000,
      "note": "`MOVE-091`: a comparable epoch above the plan's target marks the plan rebase pending and aborts nothing",
      "expect": {
        "result": {
          "superseded": false,
          "aborted": [],
          "finishing": [],
          "rebasePending": 4
        },
        "states": {
          "h-a": "verifying",
          "h-b": "transferring",
          "h-c": "planned"
        }
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-c",
      "trigger": "admittedByRatePolicy",
      "at": 50100,
      "note": "`MOVE-093`: no handoff leaves `planned` while a rebase is pending",
      "expect": {
        "outcome": {
          "outcome": "idle",
          "reason": "rebasePending"
        },
        "state": "planned"
      }
    },
    {
      "action": "snapshotInstalled",
      "topologyId": "some-other-cluster",
      "epoch": 9,
      "at": 60000,
      "note": "`MOVE-091`: a differing `topologyId` supersedes the plan.  Handoffs at `cutover` or beyond run to a terminal state.",
      "expect": {
        "result": {
          "superseded": true,
          "aborted": [
