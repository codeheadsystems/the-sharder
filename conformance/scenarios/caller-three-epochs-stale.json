{
  "scenario": "caller-three-epochs-stale",
  "description": "A caller routes against epoch 1 while the recipient holds epoch 4.  Covers every recipient relation, both policies, a retained and an unretained token epoch, an unfenced request, and a sender ahead of the recipient.",
  "requirements": [
    "ERR-040",
    "ERR-041",
    "ERR-042",
    "ERR-044",
    "FENCE-041",
    "FENCE-061",
    "FENCE-071",
    "FENCE-081",
    "FENCE-091",
    "FENCE-111",
    "FENCE-121",
    "FENCE-131",
    "FENCE-141",
    "FENCE-151",
    "TOPO-161",
    "TOPO-171"
  ],
  "deterministic": true,
  "setup": {},
  "steps": [
    {
      "action": "installTopology",
      "topology": "topologies/migration-epoch-1.topology.json",
      "expect": {
        "outcome": "installed",
        "condition": null,
        "epochInForce": 1
      }
    },
    {
      "action": "installTopology",
      "topology": "topologies/migration-epoch-2.topology.json",
      "expect": {
        "outcome": "installed",
        "condition": null,
        "epochInForce": 2
      }
    },
    {
      "action": "installTopology",
      "topology": "topologies/migration-epoch-3.topology.json",
      "expect": {
        "outcome": "installed",
        "condition": null,
        "epochInForce": 3
      }
    },
    {
      "action": "installTopology",
      "topology": "topologies/migration-epoch-4.topology.json",
      "expect": {
        "outcome": "installed",
        "condition": null,
        "epochInForce": 4
      }
    },
    {
      "action": "setRetentionDepth",
      "depth": 3,
      "expect": {
        "retainedEpochs": [
          3,
          2,
          1
        ]
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n1",
      "recipientPolicy": "strict",
      "note": "the caller is three epochs behind; epoch 1 is retained",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "owner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 302,
          "name": "epochMismatch",
          "cause": "senderBehind",
          "currentOwner": null
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n1",
      "recipientPolicy": "stable",
      "note": "the caller is three epochs behind; epoch 1 is retained",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "owner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 302,
          "name": "epochMismatch",
          "cause": "senderBehind",
          "currentOwner": null
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n3",
      "recipientPolicy": "strict",
      "note": "the caller is three epochs behind; epoch 1 is retained",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "owner",
          "ownershipStable": true,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 302,
          "name": "epochMismatch",
          "cause": "senderBehind",
          "currentOwner": null
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n3",
      "recipientPolicy": "stable",
      "note": "the caller is three epochs behind; epoch 1 is retained",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "owner",
          "ownershipStable": true,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": null,
        "served": true
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n2",
      "recipientPolicy": "strict",
      "note": "the caller is three epochs behind; epoch 1 is retained",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "notOwner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 301,
          "name": "notOwner",
          "cause": null,
          "currentOwner": "n1"
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n2",
      "recipientPolicy": "stable",
      "note": "the caller is three epochs behind; epoch 1 is retained",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "notOwner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 301,
          "name": "notOwner",
          "cause": null,
          "currentOwner": "n1"
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 1
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n3",
      "recipientPolicy": "stable",
      "retainedEpochs": [],
      "note": "`FENCE-091`: where the token's epoch is not retained, `ownershipStable` is false whatever the ownership is",
      "expect": {
        "verdict": {
          "relation": "senderBehind",
          "ownership": "owner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 302,
          "name": "epochMismatch",
          "cause": "senderBehind",
          "currentOwner": null
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": null,
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n1",
      "recipientPolicy": "strict",
      "fenced": false,
      "expect": {
        "verdict": {
          "relation": "same",
          "ownership": "owner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 302,
          "name": "epochMismatch",
          "cause": "unfenced",
          "currentOwner": null
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "migration",
        "epoch": 9
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n1",
      "recipientPolicy": "strict",
      "refreshWaitMillis": 0,
      "expect": {
        "verdict": {
          "relation": "senderAhead",
          "ownership": "owner",
          "ownershipStable": false,
          "currentOwner": "n1",
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 302,
          "name": "epochMismatch",
          "cause": "senderAhead",
          "currentOwner": null
        },
        "served": false
      }
    },
    {
      "action": "recipientCheck",
      "token": {
        "topologyId": "another-cluster",
        "epoch": 4
      },
      "key": {
        "encoding": "base16",
        "value": "50"
      },
      "selfId": "n1",
      "recipientPolicy": "stable",
      "expect": {
        "verdict": {
          "relation": "identityMismatch",
          "ownership": "unknown",
          "ownershipStable": false,
          "currentOwner": null,
          "localToken": {
            "topologyId": "migration",
            "epoch": 4
          }
        },
        "condition": {
          "code": 303,
          "name": "identityMismatch",
          "cause": null,
          "currentOwner": null
        },
        "served": false
      }
    }
  ]
}
