{
  "scenario": "handoff-happy-path",
  "level": "migration",
  "description": "One shard moves from its source to its destination through every state of `MOVE-021`, with the ownership delta that produced the plan.",
  "requirements": [
    "MOVE-001",
    "MOVE-021",
    "MOVE-031",
    "MOVE-041",
    "MOVE-051",
    "MOVE-071",
    "MOVE-121",
    "MOVE-131",
    "MOVE-181",
    "MOVE-241",
    "TOPO-211",
    "TOPO-221"
  ],
  "deterministic": true,
  "setup": {},
  "steps": [
    {
      "action": "ownershipDelta",
      "from": "topologies/migration-epoch-1.topology.json",
      "to": "topologies/migration-epoch-2.topology.json",
      "expect": {
        "shardsChanged": 1,
        "delta": [
          {
            "shard": "r1",
            "before": [
              "n2",
              "n3"
            ],
            "after": [
              "n4",
              "n3"
            ],
            "gained": [
              "n4"
            ],
            "lost": [
              "n2"
            ]
          }
        ]
      }
    },
    {
      "action": "plan",
      "from": "topologies/migration-epoch-1.topology.json",
      "to": "topologies/migration-epoch-2.topology.json",
      "policy": {
        "maxConcurrentHandoffs": 4,
        "maxConcurrentPerSourceNode": 1,
        "maxConcurrentPerDestinationNode": 1,
        "requireLinearisableCutover": true
      },
      "expect": {
        "handoffs": [
          {
            "id": "h-r1",
            "shard": "r1",
            "source": "n2",
            "destination": "n4",
            "state": "planned"
          }
        ],
        "guarantee": "linearisable"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "admittedByRatePolicy",
      "at": 1000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "prepareSuccess",
      "at": 2000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "noBulkRemaining",
      "at": 3000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "residueAtOrBelowThreshold",
      "at": 4000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "cutoverCommitted",
      "at": 5000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "cutover",
          "toState": "verifying"
        },
        "state": "verifying"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "verifySuccess",
      "at": 6000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "verifying",
          "toState": "cleanup"
        },
        "state": "cleanup"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "cleanupSuccess",
      "at": 7000,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-r1",
          "terminalState": "complete",
          "failureKind": null
        },
        "state": "complete"
      }
    },
    {
      "action": "expectSummary",
      "expect": {
        "complete": 1
      }
    }
  ]
}
