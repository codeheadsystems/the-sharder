{
  "scenario": "abort-during-catching-up",
  "level": "migration",
  "description": "An abort requested in `catchingUp` moves the handoff to `aborting` and runs compensation.  A second abort has no further effect.",
  "requirements": [
    "MOVE-021",
    "MOVE-421",
    "MOVE-491"
  ],
  "deterministic": true,
  "setup": {
    "plan": {
      "topologyId": "migration",
      "fromEpoch": 1,
      "toEpoch": 2,
      "policy": {
        "maxConcurrentHandoffs": 4,
        "maxConcurrentPerSourceNode": 1,
        "maxConcurrentPerDestinationNode": 1,
        "initialStepBudget": 1,
        "commitDeadlineMillis": 30000,
        "quiesceLeaseMarginMillis": 1000
      },
      "handoffs": [
        {
          "id": "h-1",
          "shard": "1",
          "source": "n2",
          "destination": "n4"
        }
      ]
    }
  },
  "steps": [
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "admittedByRatePolicy",
      "at": 1000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "prepareSuccess",
      "at": 2000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "noBulkRemaining",
      "at": 3000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffAbort",
      "handoff": "h-1",
      "reason": "operator requested",
      "at": 9000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "state": "aborting"
        },
        "state": "aborting"
      }
    },
    {
      "action": "handoffAbort",
      "handoff": "h-1",
      "reason": "again",
      "at": 9500,
      "note": "`MOVE-491`: an abort is idempotent",
      "expect": {
        "outcome": {
          "outcome": "noop",
          "state": "aborting"
        },
        "state": "aborting"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "rollbackSuccess",
      "at": 10000,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "aborted",
          "failureKind": null
        },
        "state": "aborted"
      }
    },
    {
      "action": "expectSummary",
      "expect": {
        "aborted": 1
      }
    }
  ]
}
