{
  "scenario": "rebalance-survives-unrelated-epoch",
  "description": "A node joins the fleet while a two-shard rebalance is in flight.  The plan is marked rebase pending rather than superseded, admits no new work until the integrator rebases it, and then finishes under the newer epoch.",
  "requirements": [
    "MOVE-091",
    "MOVE-092",
    "MOVE-093",
    "MOVE-094",
    "MOVE-096",
    "MOVE-097",
    "MOVE-101",
    "MOVE-102",
    "MOVE-103",
    "RATE-001",
    "TOPO-211"
  ],
  "deterministic": true,
  "setup": {},
  "steps": [
    {
      "action": "ownershipDelta",
      "from": "topologies/rebalance-epoch-10.topology.json",
      "to": "topologies/rebalance-epoch-11.topology.json",
      "expect": {
        "shardsChanged": 2,
        "delta": [
          {
            "shard": "r0",
            "before": [
              "n1",
              "n2"
            ],
            "after": [
              "n5",
              "n2"
            ],
            "gained": [
              "n5"
            ],
            "lost": [
              "n1"
            ]
          },
          {
            "shard": "r1",
            "before": [
              "n2",
              "n3"
            ],
            "after": [
              "n2",
              "n6"
            ],
            "gained": [
              "n6"
            ],
            "lost": [
              "n3"
            ]
          }
        ]
      }
    },
    {
      "action": "plan",
      "from": "topologies/rebalance-epoch-10.topology.json",
      "to": "topologies/rebalance-epoch-11.topology.json",
      "policy": {
        "maxConcurrentHandoffs": 4,
        "maxConcurrentPerSourceNode": 1,
        "maxConcurrentPerDestinationNode": 1,
        "requireLinearisableCutover": true
      },
      "expect": {
        "handoffs": [
          {
            "id": "h-r0",
            "shard": "r0",
            "source": "n1",
            "destination": "n5",
            "state": "planned",
            "targetEpoch": 11
          },
          {
            "id": "h-r1",
            "shard": "r1",
            "source": "n3",
            "destination": "n6",
            "state": "planned",
            "targetEpoch": 11
          }
        ],
        "guarantee": "linearisable",
        "rebaseInterval": {
          "above": 10,
          "throughInclusive": 11
        }
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "admittedByRatePolicy",
      "at": 1000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r0",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "prepareSuccess",
      "at": 1100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r0",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "noBulkRemaining",
      "at": 1200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r0",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "admittedByRatePolicy",
      "at": 2000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "prepareSuccess",
      "at": 2100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "snapshotInstalled",
      "topology": "topologies/rebalance-epoch-12.topology.json",
      "topologyId": "rebalance",
      "epoch": 12,
      "at": 10000,
      "note": "`MOVE-091` and `MOVE-092`: the epoch is comparable and above the plan's target, so the plan is marked rebase pending, no handoff is aborted, and no preference list is evaluated",
      "expect": {
        "result": {
          "superseded": false,
          "aborted": [],
          "finishing": [],
          "rebasePending": 12
        },
        "states": {
          "h-r0": "catchingUp",
          "h-r1": "transferring"
        }
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "residueAtOrBelowThreshold",
      "at": 10100,
      "note": "`MOVE-093`: a rebase-pending plan admits no handoff into `cutover`",
      "expect": {
        "outcome": {
          "outcome": "idle",
          "reason": "rebasePending"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "rebase",
      "to": "topologies/rebalance-epoch-12.topology.json",
      "at": 11000,
      "replicaSets": {
        "r0": [
          "n5",
          "n2"
        ],
        "r1": [
          "n2",
          "n6"
        ],
        "r2": [
          "n3",
          "n4"
        ],
        "r3": [
          "n4",
          "n1"
        ]
      },
      "note": "`MOVE-096`: every handoff's shard, source, and destination still hold under epoch 12, so every one of them rebases and keeps the state it was in",
      "expect": {
        "result": {
          "outcome": "rebased",
          "report": {
            "fromEpoch": 11,
            "toEpoch": 12,
            "rebased": [
              "h-r0",
              "h-r1"
            ],
            "aborted": [],
            "unchanged": []
          },
          "rebaseInterval": {
            "above": 10,
            "throughInclusive": 12
          }
        },
        "states": {
          "h-r0": "catchingUp",
          "h-r1": "transferring"
        },
        "targetEpochs": {
          "h-r0": 12,
          "h-r1": 12
        }
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "residueAtOrBelowThreshold",
      "at": 12000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r0",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "cutoverCommitted",
      "at": 12100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r0",
          "fromState": "cutover",
          "toState": "verifying"
        },
        "state": "verifying"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "verifySuccess",
      "at": 12200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r0",
          "fromState": "verifying",
          "toState": "cleanup"
        },
        "state": "cleanup"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r0",
      "trigger": "cleanupSuccess",
      "at": 12300,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-r0",
          "terminalState": "complete",
          "failureKind": null
        },
        "state": "complete"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "noBulkRemaining",
      "at": 13000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "residueAtOrBelowThreshold",
      "at": 13100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "cutoverCommitted",
      "at": 13200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "cutover",
          "toState": "verifying"
        },
        "state": "verifying"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "verifySuccess",
      "at": 13300,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-r1",
          "fromState": "verifying",
          "toState": "cleanup"
        },
        "state": "cleanup"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-r1",
      "trigger": "cleanupSuccess",
      "at": 13400,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-r1",
          "terminalState": "complete",
          "failureKind": null
        },
        "state": "complete"
      }
    },
    {
      "action": "expectSummary",
      "expect": {
        "complete": 2
      }
    }
  ]
}
