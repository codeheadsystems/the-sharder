{
  "scenario": "undetermined-resolves-both-ways",
  "level": "migration",
  "description": "A cutover whose outcome the library never established is looked at again.  The same failure resolves to `verifying` where the record landed, to `cutover` where it did not, and to `aborting` where another destination won.  The three failure kinds that need an operator are refused.",
  "requirements": [
    "ERR-052",
    "MOVE-011",
    "MOVE-021",
    "MOVE-031",
    "MOVE-102",
    "MOVE-112",
    "MOVE-181",
    "MOVE-211",
    "MOVE-212",
    "MOVE-233",
    "MOVE-234",
    "MOVE-236",
    "MOVE-237",
    "MOVE-238",
    "MOVE-331"
  ],
  "deterministic": true,
  "setup": {
    "plan": {
      "topologyId": "migration",
      "fromEpoch": 1,
      "toEpoch": 2,
      "policy": {
        "maxConcurrentHandoffs": 4,
        "maxConcurrentPerSourceNode": 1,
        "maxConcurrentPerDestinationNode": 1,
        "initialStepBudget": 1,
        "commitDeadlineMillis": 30000,
        "quiesceLeaseMarginMillis": 1000
      },
      "handoffs": [
        {
          "id": "h-1",
          "shard": "1",
          "source": "n2",
          "destination": "n4"
        }
      ]
    }
  },
  "steps": [
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "admittedByRatePolicy",
      "at": 1000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "prepareSuccess",
      "at": 1100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "noBulkRemaining",
      "at": 1200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "residueAtOrBelowThreshold",
      "at": 1300,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "commitUndetermined",
      "at": 1400,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "failed",
          "failureKind": "undetermined"
        },
        "state": "failed"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "at": 20000,
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 2,
          "owner": "n4",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-234`: the record belongs to the handoff under `MOVE-102`, so the mapping of `MOVE-211` resumes it at `verifying`",
      "expect": {
        "outcome": {
          "outcome": "resumed",
          "state": "verifying",
          "observationRow": "recordBelongingToHandoff"
        },
        "state": "verifying",
        "targetEpoch": 2
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "verifySuccess",
      "at": 21000,
      "note": "`MOVE-236`: `cleanup` still never precedes a successful `verify`",
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "verifying",
          "toState": "cleanup"
        },
        "state": "cleanup"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "cleanupSuccess",
      "at": 21100,
      "note": "`MOVE-236`: `cleanup` still never precedes a successful `verify`",
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "complete",
          "failureKind": null
        },
        "state": "complete"
      }
    },
    {
      "action": "expectSummary",
      "name": "recordExisted",
      "expect": {
        "complete": 1
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "admittedByRatePolicy",
      "at": 30000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "prepareSuccess",
      "at": 30100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "noBulkRemaining",
      "at": 30200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "residueAtOrBelowThreshold",
      "at": 30300,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "commitUndetermined",
      "at": 30400,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "failed",
          "failureKind": "undetermined"
        },
        "state": "failed"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "at": 31000,
      "observation": "unavailable",
      "note": "`MOVE-234`: an `unavailable` answer leaves the handoff where it is and `MOVE-238` makes the call free of effect",
      "expect": {
        "outcome": {
          "outcome": "unresolved",
          "state": "failed",
          "failureKind": "undetermined"
        },
        "state": "failed",
        "failureKind": "undetermined"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "at": 32000,
      "observation": {
        "cutoverRecord": null,
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-236`: an observation reporting no record resumes the handoff at `cutover`, and `MOVE-331` requires a fresh successful `quiesce` before the next `commitCutover`",
      "expect": {
        "outcome": {
          "outcome": "resumed",
          "state": "cutover",
          "observationRow": "noRecordSourceQuiesced"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffQuiesce",
      "handoff": "h-1",
      "leaseMillis": 60000,
      "at": 32500,
      "expect": {
        "outcome": {
          "outcome": "quiesced",
          "quiesceInstant": 32500,
          "leaseMillis": 60000,
          "commitHorizon": 91500,
          "state": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "cutoverCommitted",
      "at": 33000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "cutover",
          "toState": "verifying"
        },
        "state": "verifying"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "verifySuccess",
      "at": 33100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "verifying",
          "toState": "cleanup"
        },
        "state": "cleanup"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "cleanupSuccess",
      "at": 33200,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "complete",
          "failureKind": null
        },
        "state": "complete"
      }
    },
    {
      "action": "expectSummary",
      "name": "noRecord",
      "expect": {
        "complete": 1
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "admittedByRatePolicy",
      "at": 40000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "prepareSuccess",
      "at": 40100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "noBulkRemaining",
      "at": 40200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
