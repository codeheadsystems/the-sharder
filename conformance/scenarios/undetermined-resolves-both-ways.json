    {
      "action": "reobserve",
      "handoff": "h-1",
      "at": 46000,
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 7,
          "owner": "n4",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-102`: the plan's rebase interval is the epochs above 1 and at or below 2, so a record at epoch 7 belongs to another plan",
      "expect": {
        "outcome": {
          "outcome": "resumed",
          "state": "aborting",
          "observationRow": "recordNotBelongingToHandoff"
        },
        "state": "aborting",
        "rebaseInterval": {
          "above": 1,
          "throughInclusive": 2
        }
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "failureKind": "unverified",
      "at": 61000,
      "triggers": [
        "admittedByRatePolicy",
        "prepareSuccess",
        "noBulkRemaining",
        "residueAtOrBelowThreshold",
        "cutoverCommitted",
        "verifyMismatch"
      ],
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 2,
          "owner": "n4",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-237`: each of these kinds names a duty outside the library, which a further observation cannot discharge",
      "expect": {
        "outcome": {
          "outcome": "refused",
          "reason": "failureKindNotRecoverable",
          "state": "failed",
          "failureKind": "unverified"
        },
        "state": "failed",
        "failureKind": "unverified"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "failureKind": "residue",
      "at": 61000,
      "triggers": [
        "admittedByRatePolicy",
        "prepareSuccess",
        "noBulkRemaining",
        "residueAtOrBelowThreshold",
        "cutoverCommitted",
        "verifySuccess",
        "attemptsExhausted"
      ],
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 2,
          "owner": "n4",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-237`: each of these kinds names a duty outside the library, which a further observation cannot discharge",
      "expect": {
        "outcome": {
          "outcome": "refused",
          "reason": "failureKindNotRecoverable",
          "state": "failed",
          "failureKind": "residue"
        },
        "state": "failed",
        "failureKind": "residue"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "failureKind": "rollbackFailed",
      "at": 61000,
      "triggers": [
        "admittedByRatePolicy",
        "prepareSuccess",
        "abort",
        "attemptsExhausted"
      ],
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 2,
          "owner": "n4",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-237`: each of these kinds names a duty outside the library, which a further observation cannot discharge",
      "expect": {
        "outcome": {
          "outcome": "refused",
          "reason": "failureKindNotRecoverable",
          "state": "failed",
          "failureKind": "rollbackFailed"
        },
        "state": "failed",
        "failureKind": "rollbackFailed"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "at": 70100,
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 2,
          "owner": "n4",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-233`: a re-observation is admitted only from `failed`",
      "expect": {
        "outcome": {
          "outcome": "refused",
          "reason": "notFailed",
          "state": "preparing"
        },
        "state": "preparing"
