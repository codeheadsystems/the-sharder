      "handoff": "h-1",
      "trigger": "residueAtOrBelowThreshold",
      "at": 40300,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "commitUndetermined",
      "at": 40400,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "failed",
          "failureKind": "undetermined"
        },
        "state": "failed"
      }
    },
    {
      "action": "reobserve",
      "handoff": "h-1",
      "at": 41000,
      "observation": {
        "cutoverRecord": {
          "shardId": "1",
          "topologyId": "migration",
          "epoch": 2,
          "owner": "n3",
          "opaque": ""
        },
        "destinationPrepared": true,
        "sourceQuiesced": true,
        "sourceResidue": false
      },
      "note": "`MOVE-102`: the record names another owner, so it does not belong to this handoff and `MOVE-236` admits the compensation",
      "expect": {
        "outcome": {
          "outcome": "resumed",
          "state": "aborting",
          "observationRow": "recordNotBelongingToHandoff"
        },
        "state": "aborting"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "admittedByRatePolicy",
      "at": 45000,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "planned",
          "toState": "preparing"
        },
        "state": "preparing"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "prepareSuccess",
      "at": 45100,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "preparing",
          "toState": "transferring"
        },
        "state": "transferring"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "noBulkRemaining",
      "at": 45200,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "transferring",
          "toState": "catchingUp"
        },
        "state": "catchingUp"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "residueAtOrBelowThreshold",
      "at": 45300,
      "expect": {
        "outcome": {
          "outcome": "advanced",
          "id": "h-1",
          "fromState": "catchingUp",
          "toState": "cutover"
        },
        "state": "cutover"
      }
    },
    {
      "action": "handoffStep",
      "handoff": "h-1",
      "trigger": "commitUndetermined",
      "at": 45400,
      "expect": {
        "outcome": {
          "outcome": "settled",
          "id": "h-1",
          "terminalState": "failed",
          "failureKind": "undetermined"
        },
        "state": "failed"
