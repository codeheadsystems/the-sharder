{
  "scenario": "redirect-walk-depth-limit",
  "description": "A caller follows `currentOwner` refusals, and the walk terminates at the redirect bound or on revisiting a node it already attempted.",
  "requirements": [
    "CFG-040",
    "ERR-043",
    "FENCE-171",
    "FENCE-181",
    "FENCE-191",
    "FENCE-211"
  ],
  "deterministic": true,
  "setup": {},
  "steps": [
    {
      "action": "redirectWalk",
      "name": "served-immediately",
      "start": "n2",
      "refusals": {
        "n2": null
      },
      "maxRedirects": 2,
      "note": "the first node serves",
      "expect": {
        "attempted": [
          "n2"
        ],
        "outcome": "served",
        "redirectsFollowed": 0
      }
    },
    {
      "action": "redirectWalk",
      "name": "one-redirect",
      "start": "n2",
      "refusals": {
        "n2": "n4",
        "n4": null
      },
      "maxRedirects": 2,
      "note": "one hop",
      "expect": {
        "attempted": [
          "n2",
          "n4"
        ],
        "outcome": "served",
        "redirectsFollowed": 1
      }
    },
    {
      "action": "redirectWalk",
      "name": "bound-reached",
      "start": "n2",
      "refusals": {
        "n2": "n4",
        "n4": "n3",
        "n3": "n1",
        "n1": null
      },
      "maxRedirects": 2,
      "note": "`FENCE-181`: the walk stops at `maxRedirects`, defaulting to 2",
      "expect": {
        "attempted": [
          "n2",
          "n4",
          "n3"
        ],
        "outcome": "redirectExhausted",
        "cause": "boundReached",
        "redirectsFollowed": 2,
        "condition": {
          "code": 304,
          "name": "redirectExhausted"
        }
      }
    },
    {
      "action": "redirectWalk",
      "name": "revisited-node",
      "start": "n2",
      "refusals": {
        "n2": "n4",
        "n4": "n2"
      },
      "maxRedirects": 5,
      "note": "`FENCE-191`: a redirect naming an already attempted node terminates the walk",
      "expect": {
        "attempted": [
          "n2",
          "n4"
        ],
        "outcome": "redirectExhausted",
        "cause": "revisitedNode",
        "redirectsFollowed": 1,
        "condition": {
          "code": 304,
          "name": "redirectExhausted"
        }
      }
    },
    {
      "action": "redirectWalk",
      "name": "bound-zero",
      "start": "n2",
      "refusals": {
        "n2": "n4"
      },
      "maxRedirects": 0,
      "note": "a bound of 0 permits no redirect at all",
      "expect": {
        "attempted": [
          "n2"
        ],
        "outcome": "redirectExhausted",
        "cause": "boundReached",
        "redirectsFollowed": 0,
        "condition": {
          "code": 304,
          "name": "redirectExhausted"
        }
      }
    }
  ]
}
