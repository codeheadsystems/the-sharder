{
  "vectorSet": "validation-documents",
  "kind": "validation",
  "description": "Documents that fail a load-time rule, each with the rules it breaks, and every valid document in the suite as a negative control.  A port reports every error rather than the first, under `ERR-030`.",
  "requirements": [
    "ERR-030",
    "OVR-015",
    "OVR-028",
    "PLACE-067",
    "REPL-004",
    "TOPO-001",
    "TOPO-011",
    "TOPO-191"
  ],
  "cases": [
    {
      "name": "constrain-undeclared-level",
      "requirements": [
        "TOPO-001",
        "TOPO-011",
        "TOPO-191",
        "ERR-030"
      ],
      "document": "topologies/invalid/constrain-undeclared-level.topology.json",
      "stage": "semantic",
      "note": "rejected at stage 3, the semantic rules of TOPO-001",
      "expect": {
        "valid": false,
        "condition": {
          "code": 201,
          "name": "invalidTopology"
        },
        "rules": [
          "undeclaredLevel"
        ],
        "errors": [
          {
            "path": "overrides[0].constrain.domains",
            "rule": "undeclaredLevel",
            "detail": "region"
          }
        ]
      }
    },
