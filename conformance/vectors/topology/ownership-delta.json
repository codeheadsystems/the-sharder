      "before": "topologies/delta-before.topology.json",
      "after": "topologies/delta-other-seed.topology.json",
      "note": "`TOPO-231`: shard identity is not comparable across a change to hash.seed, so the delta is refused rather than computed.",
      "expect": {
        "comparable": false,
        "differingField": "hash.seed",
        "condition": {
          "code": 401,
          "name": "planRefused",
          "cause": "incomparableShards"
        }
      }
    },
