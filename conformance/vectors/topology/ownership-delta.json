              "b"
            ],
            "after": [
              "b",
              "a"
            ],
            "gained": [],
            "lost": []
          }
        ]
      }
    },
    {
      "name": "differing-slot-count",
      "requirements": [
        "TOPO-231",
        "SEC-013",
        "ERR-010"
      ],
      "before": "topologies/delta-before.topology.json",
      "after": "topologies/delta-other-slot-count.topology.json",
      "note": "`TOPO-231`: shard identity is not comparable across a change to slotCount, so the delta is refused rather than computed.",
      "expect": {
        "comparable": false,
        "differingField": "slotCount",
        "condition": {
          "code": 401,
          "name": "planRefused",
          "cause": "incomparableShards"
        }
      }
    },
    {
      "name": "differing-seed",
      "requirements": [
        "TOPO-231",
        "SEC-013",
        "ERR-010"
