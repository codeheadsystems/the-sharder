{
  "vectorSet": "observability-inventory-migration",
  "kind": "observabilityInventory",
  "level": "migration",
  "description": "The metric and event names, label sets, severities, and payload members of the `migration` surface, as `OBS-010` and `OBS-020` state them.",
  "requirements": [
    "OBS-001",
    "OBS-003",
    "OBS-010",
    "OBS-020",
    "OBS-021"
  ],
  "cases": [
    {
      "name": "metric-inventory",
      "requirements": [
        "OBS-001",
        "OBS-003",
        "OBS-010"
      ],
      "note": "`OBS-010` names each metric and its label set.  A port compares the names it registers and the labels it attaches against these, and a name it does not register is a metric it does not expose.",
      "expect": {
        "surface": "migration",
        "metricCount": 5,
        "names": [
          "sharder.migration.cutover_window_millis",
          "sharder.migration.handoffs",
          "sharder.migration.hook_duration_millis",
          "sharder.migration.pressure",
          "sharder.migration.units_moved"
        ],
        "metrics": [
          {
            "name": "sharder.migration.units_moved",
            "instrument": "counter",
            "labels": [
              "topology_id"
            ]
          },
          {
            "name": "sharder.migration.handoffs",
            "instrument": "gauge",
            "labels": [
              "state",
              "topology_id"
            ]
          },
          {
            "name": "sharder.migration.pressure",
            "instrument": "gauge",
            "labels": [
              "level",
              "scope"
            ]
          },
          {
            "name": "sharder.migration.hook_duration_millis",
            "instrument": "histogram",
            "labels": [
              "hook",
              "outcome"
            ]
          },
          {
            "name": "sharder.migration.cutover_window_millis",
            "instrument": "histogram",
            "labels": [
              "topology_id"
            ]
          }
        ],
        "labelValues": {}
      }
    },
    {
      "name": "event-inventory",
      "requirements": [
        "OBS-020",
        "OBS-021"
      ],
      "note": "`OBS-020` names each event, the severity it carries, and the payload members it carries beyond the common members of `OBS-021`.  A port may carry further members and may not rename one of these.  A `deduplication` member appears on the four events `OBS-024` names and on no other.",
      "expect": {
        "surface": "migration",
        "eventCount": 9,
        "names": [
          "sharder.migration.cutover_committed",
          "sharder.migration.failed",
          "sharder.migration.planned",
          "sharder.migration.quiesce_expired",
          "sharder.migration.rebase_pending",
          "sharder.migration.rebased",
          "sharder.migration.reobserved",
          "sharder.migration.state_changed",
          "sharder.migration.superseded"
        ],
        "events": [
          {
            "name": "sharder.migration.planned",
            "severity": "info",
            "payload": [
              "handoffCount",
              "policy"
            ]
          },
          {
            "name": "sharder.migration.state_changed",
            "severity": "info",
            "payload": [
              "handoff",
              "shard",
              "from",
              "to",
              "trigger"
            ]
          },
          {
            "name": "sharder.migration.cutover_committed",
            "severity": "info",
            "payload": [
              "shard",
              "source",
              "destination",
              "windowMillis"
            ]
          },
          {
            "name": "sharder.migration.quiesce_expired",
            "severity": "error",
            "payload": [
              "handoff",
              "shard",
              "leaseMillis",
              "marginMillis"
            ]
          },
          {
            "name": "sharder.migration.failed",
            "severity": "error",
            "payload": [
              "shard",
              "kind",
              "source",
              "destination"
            ]
          },
          {
            "name": "sharder.migration.superseded",
            "severity": "warning",
            "payload": [
              "installedEpoch",
              "abortedCount",
              "finishingCount"
            ]
          },
          {
            "name": "sharder.migration.rebase_pending",
            "severity": "warning",
            "payload": [
              "installedEpoch",
              "targetEpoch"
            ]
          },
          {
            "name": "sharder.migration.rebased",
            "severity": "info",
            "payload": [
              "fromEpoch",
              "toEpoch",
              "rebased",
              "aborted",
              "unchanged"
            ]
          },
          {
            "name": "sharder.migration.reobserved",
            "severity": "info",
            "payload": [
              "handoff",
              "shard",
              "answer",
              "resumedState"
            ]
          }
        ]
      }
    }
  ]
}
