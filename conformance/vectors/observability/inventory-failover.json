{
  "vectorSet": "observability-inventory-failover",
  "kind": "observabilityInventory",
  "level": "failover",
  "description": "The metric and event names, label sets, severities, and payload members of the `failover` surface, as `OBS-010` and `OBS-020` state them.",
  "requirements": [
    "OBS-001",
    "OBS-003",
    "OBS-010",
    "OBS-020",
    "OBS-021"
  ],
  "cases": [
    {
      "name": "metric-inventory",
      "requirements": [
        "OBS-001",
        "OBS-003",
        "OBS-010"
      ],
      "note": "`OBS-010` names each metric and its label set.  A port compares the names it registers and the labels it attaches against these, and a name it does not register is a metric it does not expose.",
      "expect": {
        "surface": "failover",
        "metricCount": 5,
        "names": [
          "sharder.health.ejections",
          "sharder.health.ejections_refused",
          "sharder.health.failure_percent",
          "sharder.health.nodes",
          "sharder.health.transitions"
        ],
        "metrics": [
          {
            "name": "sharder.health.transitions",
            "instrument": "counter",
            "labels": [
              "from",
              "to",
              "topology_id"
            ]
          },
          {
            "name": "sharder.health.ejections",
            "instrument": "counter",
            "labels": [
              "node"
            ]
          },
          {
            "name": "sharder.health.ejections_refused",
            "instrument": "counter",
            "labels": [
              "topology_id"
            ]
          },
          {
            "name": "sharder.health.nodes",
            "instrument": "gauge",
            "labels": [
              "state",
              "topology_id"
            ]
          },
          {
            "name": "sharder.health.failure_percent",
            "instrument": "gauge",
            "labels": [
              "node"
            ]
          }
        ],
        "labelValues": {}
      }
    },
    {
      "name": "event-inventory",
      "requirements": [
        "OBS-020",
        "OBS-021"
      ],
      "note": "`OBS-020` names each event, the severity it carries, and the payload members it carries beyond the common members of `OBS-021`.  A port may carry further members and may not rename one of these.  A `deduplication` member appears on the four events `OBS-024` names and on no other.",
      "expect": {
        "surface": "failover",
        "eventCount": 2,
        "names": [
          "sharder.health.ejection_refused",
          "sharder.health.transition"
        ],
        "events": [
          {
            "name": "sharder.health.transition",
            "severity": "info",
            "payload": [
              "node",
              "from",
              "to",
              "trigger"
            ]
          },
          {
            "name": "sharder.health.ejection_refused",
            "severity": "warning",
            "payload": [
              "node",
              "ejected",
              "setSize"
            ]
          }
        ]
      }
    }
  ]
}
