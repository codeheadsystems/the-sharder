{
  "vectorSet": "keytransform-prefix-fields-1",
  "kind": "keyTransform",
  "description": "The `prefixFields` transform at a count of 1.",
  "requirements": [
    "KEY-011",
    "KEY-014",
    "KEY-040",
    "KEY-041",
    "KEY-042",
    "KEY-043"
  ],
  "cases": [
    {
      "name": "tenant",
      "requirements": [
        "KEY-041"
      ],
      "key": {
        "encoding": "utf8",
        "value": "acme:orders:99"
      },
      "note": "the octets before the first separator",
      "expect": {
        "routingKey": "61636d65"
      }
    },
    {
      "name": "no-separator",
      "requirements": [
        "KEY-041"
      ],
      "key": {
        "encoding": "utf8",
        "value": "acme"
      },
      "note": "KEY-042",
      "expect": {
        "routingKey": "61636d65"
      }
    },
    {
      "name": "trailing-separator",
      "requirements": [
        "KEY-041"
      ],
      "key": {
        "encoding": "utf8",
        "value": "acme:"
      },
      "note": "the whole prefix, with an empty remainder",
      "expect": {
        "routingKey": "61636d65"
      }
    },
    {
      "name": "separator-at-zero",
      "requirements": [
        "KEY-041"
      ],
      "key": {
        "encoding": "utf8",
        "value": ":x"
      },
      "note": "KEY-043 and KEY-014: the empty routing key, not the whole key",
      "expect": {
        "routingKey": ""
      }
    },
    {
      "name": "empty-key",
      "requirements": [
        "KEY-041"
      ],
      "key": {
        "encoding": "utf8",
        "value": ""
      },
      "note": "KEY-042",
      "expect": {
        "routingKey": ""
      }
    },
    {
      "name": "only-separator",
      "requirements": [
        "KEY-041"
      ],
      "key": {
        "encoding": "utf8",
        "value": ":"
      },
      "note": "KEY-043",
      "expect": {
        "routingKey": ""
      }
    }
  ],
  "topology": "topologies/kt-prefix-1.topology.json"
}
